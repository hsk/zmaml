        defb "HANDBELL    "
        defb "ORGAN       "
        defb "FLUTE       "
        defb "MUSIC BOX   "
        defb "CHIPTUNE    "

; SCC の周波数（C2 から C7 まで）。値 = 3579545 / (32 x Hz) - 1
freq_table:
        defw 1709, 1613, 1523, 1437, 1356, 1280, 1208, 1140
        defw 1076, 1016, 959, 905, 854, 806, 761, 718
        defw 678, 640, 604, 570, 538, 507, 479, 452
        defw 427, 403, 380, 359, 338, 319, 301, 284
        defw 268, 253, 239, 225, 213, 201, 189, 179
        defw 169, 159, 150, 142, 134, 126, 119, 112
        defw 106, 100, 94, 89, 84, 79, 75, 70
        defw 66, 63, 59, 56, 52

; トラックの初期値（曲の場所, チャンネル, 移調, 音量, 音量の減らし方。減らして、ハンドベルのように響かせる）
trk     macro p_data, p_ch, p_tr, p_vol, p_dec
        defw p_data
        defb 1, p_ch, p_tr, p_vol
        defw p_data
        defb p_dec, 0
        endm

track_init:
        trk mel_data, 0, 0, 15, 4       ; メロディ（ハンドベル）
        trk arp_data, 1, 0, 9, 4        ; 和音のアルペジオ
        trk bass_data, 2, 0, 13, 4      ; ベース（低いベル）
        trk mel_data, 3, 12, 8, 4       ; メロディの 1 オクターブ上（きらきらした高いベル）

; ============================================================
;  楽譜
; ============================================================

; ---- 4 拍子の 1 小節 ----
arp4    macro p_a, p_b, p_c
        nt p_a, T8
        nt p_b, T8
        nt p_c, T8
        nt p_b, T8
        nt p_a, T8
        nt p_b, T8
        nt p_c, T8
        nt p_b, T8
        endm

bass4   macro p_r, p_f
        nt p_r, T4
        nt p_f, T4
        nt p_r, T4
        nt p_f, T4
        endm

; ---- 3 拍子の 1 小節 ----
arp3    macro p_a, p_b, p_c
        nt p_a, T8
        nt p_b, T8
        nt p_c, T8
        nt p_b, T8
        nt p_c, T8
        nt p_b, T8
        endm

bass3   macro p_r, p_f
        nt p_r, T4
        nt p_f, T4
        nt p_f, T4
        endm

; ---- Jingle Bells（サビ 8 小節）----
jb_mel  macro
        nt E4, T4
        nt E4, T4
        nt E4, T2
        nt E4, T4
        nt E4, T4
        nt E4, T2
        nt E4, T4
        nt G4, T4
        nt C4, T4D
        nt D4, T8
        nt E4, T1
        nt F4, T4
        nt F4, T4
        nt F4, T4D
        nt F4, T8
        nt F4, T4
        nt E4, T4
        nt E4, T4
        nt E4, T8
        nt E4, T8
        nt E4, T4
        nt D4, T4
        nt D4, T4
        nt E4, T4
        nt D4, T2
        nt G4, T2
        endm

jb_bass macro
        bass4 C2, G2
        bass4 C2, G2
        bass4 C2, G2
        bass4 C2, G2
        bass4 F2, C3
        bass4 C2, G2
        bass4 G2, D3
        bass4 G2, D3
        endm

jb_arp  macro
        arp4 C3, E3, G3
        arp4 C3, E3, G3
        arp4 C3, E3, G3
        arp4 C3, E3, G3
        arp4 F3, A3, C4
        arp4 C3, E3, G3
        arp4 G3, B3, D4
        arp4 G3, B3, D4
        endm

; ---- We Wish You a Merry Christmas（ 1 拍の弱起 + 8 小節）----
ww_mel  macro
        nt G4, T4
        nt C5, T4
        nt C5, T8
        nt D5, T8
        nt C5, T8
        nt B4, T8
        nt A4, T4
        nt A4, T4
        nt A4, T4
        nt D5, T4
        nt D5, T8
        nt E5, T8
        nt D5, T8
        nt C5, T8
        nt B4, T4
        nt G4, T4
        nt G4, T4
        nt E5, T4
        nt E5, T8
        nt F5, T8
        nt E5, T8
        nt D5, T8
        nt C5, T4
        nt A4, T4
        nt G4, T8
        nt G4, T8
        nt A4, T4
        nt D5, T4
        nt B4, T4
        nt C5, T2D
        endm

ww_bass macro
        nt RS, T4
        bass3 C2, G2
        bass3 F2, C3
        bass3 G2, D3
        bass3 G2, D3
        bass3 C2, G2
        bass3 F2, C3
        bass3 G2, D3
        nt C2, T2D
        endm

ww_arp  macro
        nt RS, T4
        arp3 C3, E3, G3
        arp3 F3, A3, C4
        arp3 G3, B3, D4
        arp3 G3, B3, D4
        arp3 C3, E3, G3
        arp3 F3, A3, C4
        arp3 G3, B3, D4
        arp3 C3, E3, G3
        endm

mel_data:
        jb_mel
        jb_mel
        nt C4, T1
        ww_mel
        defb END, 0

bass_data:
        jb_bass
        jb_bass
        nt C2, T1
        ww_bass
        defb END, 0

arp_data:
        jb_arp
        jb_arp
        arp4 C3, E3, G3
        ww_arp
        defb END, 0
